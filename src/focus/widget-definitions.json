    }
  },

  "state": {
    "field": "active",
    "initial": true,
    "toggleable": true
  },

  "ordering": {
    "primary": {
      "field": "createdAt",
      "direction": "descending"
    },
    "priority": {
      "field": "active",
      "value": true
    }
  },

  "controls": [
    {
      "type": "widget-selector"
    },
    {
      "type": "status",
      "id": "counter",
      "metric": "active"
    },
    {
      "type": "icon-action",
      "id": "clear",
      "icon": "trash-2"
    }
  ],

  "itemActions": [
    {
      "id": "toggle",
      "type": "toggle-state"
    },
    {
      "id": "delete",
      "type": "delete"
    }
  ],

  "transfer": {
    "inputs": [
      "text"
