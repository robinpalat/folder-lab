  "emptyState": {
    "message": "Arrastra aquí un fragmento de texto"
  }
  
},

"candidates": {
  "id": "candidates",
  "identity": {
    "label": "Candidatos",
    "icon": "list-checks",
    "color": "#6B8E5A",
    "description": "Candidatos seleccionables"
  },
  "cardinality": "multiple",
  "storage": {
    "scope": "note-instance"
  },
  "entity": {
    "collection": "items",
    "content": {
      "fields": ["text"],
      "renderer": "expandable-text",
      "editable": false,
      "expandable": true,
      "previewLines": 3
    }
  },
  "state": {
    "field": "selected",
    "initial": false,
    "toggleable": false
  },
  "selection": {
    "mode": "single",
    "field": "selected"
  },
  "ordering": {
    "primary": {
      "field": "createdAt",
      "direction": "descending"
    }
  },
  "controls": [
    {
      "type": "widget-selector"
    },
    {
      "type": "status",
      "id": "counter",
      "metric": "total"
    },
    {
      "type": "icon-action",
      "id": "clear",
      "icon": "trash-2"
    }
  ],
  "itemActions": [
    {
      "id": "select",
      "type": "select"
    },
    {
      "id": "delete",
      "type": "delete"
    }
  ],
  "transfer": {
    "inputs": ["text"],
    "outputs": ["text"]
  },
  "metrics": {
  "total": {
    "type": "count"
  }
},
  "emptyState": {
    "message": "Arrastra aquí un fragmento de texto"
  }
},

"tasks": {
  "id": "tasks",
  "identity": {
    "label": "Tareas",
    "icon": "check-square",
    "color": "#7A6A9A",
    "description": "Lista de tareas"
  },
  "cardinality": "multiple",
  "storage": {
    "scope": "note-instance"
  },
  "entity": {
    "collection": "items",
    "content": {
      "fields": ["text"],
      "renderer": "expandable-text",
      "editable": true,
      "expandable": true,
      "previewLines": 3
    }
  },
  "state": {
    "field": "completed",
    "initial": true,
    "toggleable": true
  },
  "ordering": {
    "primary": {
      "field": "createdAt",
      "direction": "descending"
    },
    "priority": {
      "field": "completed",
      "value": false
    }
  },
  "controls": [
    {
      "type": "widget-selector"
    },
    {
      "type": "status",
      "id": "counter",
      "metric": "pending"
    },
    {
      "type": "icon-action",
      "id": "clear-completed",
      "icon": "trash-2"
    }
  ],
  "itemActions": [
    {
      "id": "toggle",
      "type": "toggle-state"
    },
    {
      "id": "delete",
      "type": "delete"
    }
  ],
  "input": {
    "text": {
      "enabled": true,
      "placeholder": "Nueva tarea..."
    }
  },
  "transfer": {
    "inputs": ["text"],
    "outputs": ["text"]
  },
"metrics": {
  "total": {
    "type": "count"
  },
  "completed": {
    "type": "count",
    "field": "completed",
    "value": true
  },
  "pending": {
    "type": "count",
    "field": "completed",
    "value": true
  }
},
  "emptyState": {
    "message": "Crea una tarea o arrastra aquí un texto"
  }
}

}
}
