{
  "widgets": {

"snips": {
  "id": "snips",

  "identity": {
    "label": "Snips",
    "icon": "scissors",
    "color": "#C47A3A",
    "description": "Fragmentos de texto consolidados"
  },

  "cardinality": "multiple",

  "storage": {
    "scope": "note-instance"
  },

  "entity": {
    "collection": "items",
    "content": {
      "fields": ["text"],
      "renderer": "expandable-text",
      "editable": false,
      "expandable": true,
      "previewLines": 3
    }
  },

  "state": {
    "field": "active",
    "initial": true,
    "toggleable": true
  },

  "ordering": {
    "primary": {
      "field": "createdAt",
      "direction": "descending"
    },
    "priority": {
      "field": "active",
      "value": true
    }
  },

  "controls": [
    {
      "type": "widget-selector"
    },
    {
      "type": "status",
      "id": "counter",
      "metric": "total"
    },
    {
      "type": "icon-action",
      "id": "clear",
      "icon": "trash-2"
    }
  ],

  "itemActions": [
    {
      "id": "toggle",
      "type": "toggle-state"
    },
    {
      "id": "delete",
      "type": "delete"
    }
  ],

  "transfer": {
    "inputs": ["text"],
    "outputs": ["text"]
  },

  "metrics": {
    "total": {
      "type": "count"
    }
  },

  "emptyState": {
    "message": "Arrastra aquí un fragmento de texto"
  }
},

    "collections": {
      "id": "collections",
      "identity": {
        "label": "Colecciones",
