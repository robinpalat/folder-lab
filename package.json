{
  "name": "folder-lab",
  "version": "1.0.0",
  "description": "Ordena carpetas en Obsidian manualmente",
  "main": "main.js",
  "scripts": {
    "generate-manifest": "node scripts/generate-manifest.js",
    "build": "npm run generate-manifest && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "npm run generate-manifest && tsc -noEmit -skipLibCheck && node esbuild.config.mjs"
  },
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.9.3"
  }
}
